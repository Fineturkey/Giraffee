{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Roblox: Check project",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "scripts\\check.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Roblox: Serve (if not already running)",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "scripts\\serve.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
